# ---- Database ----
# Local dev: postgresql://user:password@localhost:5432/psych_platform
DATABASE_URL="postgresql://user:password@localhost:5432/psych_platform"

# ---- Auth (NextAuth) ----
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# ---- Storage provider ----
# local | r2 | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/audio"
# Cloudflare R2 / S3-compatible (only needed if STORAGE_PROVIDER != local)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---- Speech-to-text provider ----
# whisper_local | whisper_api | openai
STT_PROVIDER="whisper_local"
WHISPER_LOCAL_MODEL="medium"
WHISPER_LOCAL_URL="http://localhost:9000"
OPENAI_API_KEY=""

# ---- Diarization provider ----
# pyannote_local | none
DIARIZATION_PROVIDER="pyannote_local"
PYANNOTE_SERVICE_URL="http://localhost:9001"

# ---- LLM provider ----
# ollama_local | anthropic | openai
LLM_PROVIDER="ollama_local"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
ANTHROPIC_API_KEY=""

# ---- Embeddings (semantic search) ----
EMBEDDING_PROVIDER="ollama_local"
EMBEDDING_MODEL="nomic-embed-text"

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
